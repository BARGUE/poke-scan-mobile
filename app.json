{
  "expo": {
    "name": "Pokémon Scanner",
    "slug": "pokemon-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.pokemonscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Nous utilisons la caméra pour scanner vos cartes Pokémon.",
        "NSPhotoLibraryUsageDescription": "Nous accédons à vos photos pour analyser vos cartes Pokémon."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E24B4A"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.yourname.pokemonscanner",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Pokémon Scanner à utiliser la caméra pour scanner vos cartes.",
          "recordAudioAndroidPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Pokémon Scanner à accéder à vos photos."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E24B4A",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ebb3e2b-fd6a-4b40-9ad1-08bb6fe1dc82"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0ebb3e2b-fd6a-4b40-9ad1-08bb6fe1dc82"
    }
  }
}
